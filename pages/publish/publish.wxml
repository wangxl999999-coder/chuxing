<view class="publish-container">
  <view class="form-section">
    <view class="form-card">
      <view class="location-group">
        <view class="location-item">
          <view class="location-dot start-dot"></view>
          <input 
            class="location-input" 
            placeholder="输入出发地" 
            value="{{start}}"
            bindinput="onStartInput"
            bindfocus="onChooseStart"
          ></input>
          <text class="location-arrow">›</text>
        </view>
        
        <view class="swap-btn" bindtap="swapLocation">
          <text class="swap-icon">↑↓</text>
        </view>
        
        <view class="location-item">
          <view class="location-dot end-dot"></view>
          <input 
            class="location-input" 
            placeholder="输入目的地" 
            value="{{end}}"
            bindinput="onEndInput"
            bindfocus="onChooseEnd"
          ></input>
          <text class="location-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-card">
      <view class="form-row">
        <view class="form-item" bindtap="onDateTap">
          <text class="form-label">出发日期</text>
          <view class="form-value-wrap">
            <text class="form-value">{{date}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
        
        <view class="form-divider"></view>
        
        <view class="form-item" bindtap="onTimeTap">
          <text class="form-label">出发时间</text>
          <view class="form-value-wrap">
            <text class="form-value">{{time}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="form-divider"></view>

      <view class="form-item">
        <text class="form-label">座位数</text>
        <picker mode="selector" range="{{seatOptions}}" bindchange="onSeatsChange">
          <view class="form-value-wrap">
            <text class="form-value">{{seats}}个座位</text>
            <text class="form-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-header">
      <text class="form-title">车辆信息</text>
    </view>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">车牌号</text>
        <input 
          class="form-input" 
          placeholder="请输入车牌号" 
          value="{{vehicle.plateNumber}}"
          bindinput="onVehicleInput"
          data-field="plateNumber"
        ></input>
      </view>

      <view class="form-divider"></view>

      <view class="form-item">
        <text class="form-label">品牌型号</text>
        <input 
          class="form-input" 
          placeholder="如：大众朗逸" 
          value="{{vehicle.brand}} {{vehicle.model}}"
          bindinput="onVehicleInput"
          data-field="brand"
        ></input>
      </view>

      <view class="form-divider"></view>

      <view class="form-item">
        <text class="form-label">颜色</text>
        <input 
          class="form-input" 
          placeholder="如：白色" 
          value="{{vehicle.color}}"
          bindinput="onVehicleInput"
          data-field="color"
        ></input>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">费用(元/人)</text>
        <input 
          class="form-input price-input" 
          type="number" 
          placeholder="请输入费用" 
          value="{{fee}}"
          bindinput="onFeeInput"
        ></input>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-card">
      <view class="form-item-textarea">
        <text class="form-label">路线备注</text>
        <textarea 
          class="form-textarea" 
          placeholder="填写途经点、注意事项等信息（选填）" 
          value="{{remark}}"
          bindinput="onRemarkInput"
          maxlength="200"
        ></textarea>
        <text class="textarea-count">{{remark.length}}/200</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">联系电话</text>
        <input 
          class="form-input" 
          type="number" 
          placeholder="请输入联系电话" 
          value="{{phone}}"
          bindinput="onPhoneInput"
          maxlength="11"
        ></input>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="agreement-row">
      <checkbox-group bindchange="onAgreementChange">
        <checkbox value="agreement" checked="{{agreement}}" class="agreement-checkbox"></checkbox>
      </checkbox-group>
      <text class="agreement-text">我已阅读并同意</text>
      <text class="agreement-link" bindtap="showAgreement">《合乘协议》</text>
    </view>
  </view>

  <view class="submit-section">
    <button class="btn-primary btn-block submit-btn" bindtap="handlePublish">
      发布拼车信息
    </button>
  </view>

  <picker 
    wx:if="{{showDatePicker}}"
    mode="date" 
    value="{{date}}" 
    start="{{date}}" 
    bindchange="onDateChange"
    bindcancel="onDateCancel"
  ></picker>

  <picker 
    wx:if="{{showTimePicker}}"
    mode="time" 
    value="{{time}}" 
    bindchange="onTimeChange"
    bindcancel="onTimeCancel"
  ></picker>
</view>
