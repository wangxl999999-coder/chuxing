.trips-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #666;
}

.tab-item.active .tab-text {
  color: #1890ff;
  font-weight: 500;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

.trip-list {
  padding: 20rpx 30rpx;
}

.trip-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.trip-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.route-info {
  display: flex;
  align-items: center;
}

.location-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.route-arrow {
  margin: 0 16rpx;
  color: #1890ff;
  font-size: 28rpx;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-badge.active {
  background: #e6f7ff;
  color: #1890ff;
}

.status-badge.completed {
  background: #f5f5f5;
  color: #999;
}

.status-badge.booked {
  background: #f6ffed;
  color: #52c41a;
}

.trip-body {
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.seats-value {
  color: #333;
}

.seats-available {
  color: #52c41a;
  font-size: 32rpx;
  font-weight: 500;
}

.seats-total {
  color: #999;
}

.price-value {
  color: #ff4d4f;
  font-weight: 500;
}

.trip-footer {
  padding-top: 16rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
