page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.login-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.form-section {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.input-group {
  margin-bottom: 36rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.input-field {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background: #f7f8fa;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
  box-sizing: border-box;
}

.input-field:focus {
  background: #f0f5ff;
}

.code-group {
  margin-bottom: 36rpx;
}

.code-input-wrap {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  margin-right: 20rpx;
}

.code-btn {
  width: 220rpx;
  height: 96rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.code-btn.disabled {
  background: #ccc;
}

.submit-btn {
  height: 96rpx;
  margin-top: 20rpx;
  font-size: 34rpx;
  border-radius: 16rpx;
}

.toggle-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.link-text {
  color: #1890ff;
  margin-left: 8rpx;
}

.divider-section {
  display: flex;
  align-items: center;
  margin: 60rpx 0 40rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e8e8e8;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #999;
}

.other-login {
  display: flex;
  justify-content: center;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 48rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.wx-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
}

.agreement {
  text-align: center;
  margin-top: 60rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.agreement-link {
  color: rgba(255, 255, 255, 0.9);
}
