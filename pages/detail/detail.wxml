<view class="detail-container" wx:if="{{ride}}">
  <view class="user-section">
    <view class="user-card">
      <view class="user-info">
        <image class="avatar" src="{{ride.publisher.avatar}}" mode="aspectFill"></image>
        <view class="user-detail">
          <text class="nickname">{{ride.publisher.nickname}}</text>
          <view class="vehicle-tags">
            <text class="tag">{{ride.vehicle.brand}} {{ride.vehicle.model}}</text>
            <text class="tag">{{ride.vehicle.color}}</text>
            <text class="tag">座位 {{ride.vehicle.seats}}座</text>
          </view>
        </view>
      </view>
      <button class="contact-btn" bindtap="onContactTap">
        <text class="contact-icon">📞</text>
        <text class="contact-text">联系车主</text>
      </button>
    </view>
  </view>

  <view class="route-section">
    <view class="route-card">
      <view class="route-item">
        <view class="route-dot start-dot"></view>
        <view class="route-content">
          <text class="location-name">{{ride.start.name}}</text>
          <text class="location-distance">距我 {{ride.startDistance}}</text>
        </view>
      </view>
      
      <view class="route-connector">
        <view class="connector-line"></view>
        <view class="connector-icon">→</view>
      </view>
      
      <view class="route-item">
        <view class="route-dot end-dot"></view>
        <view class="route-content">
          <text class="location-name">{{ride.end.name}}</text>
          <text class="location-distance">距我 {{ride.endDistance}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="info-section">
    <view class="info-card">
      <view class="info-row">
        <view class="info-item">
          <text class="info-icon">🕐</text>
          <view class="info-content">
            <text class="info-label">出发时间</text>
            <text class="info-value">{{ride.formattedDate}}</text>
          </view>
        </view>
      </view>
      
      <view class="info-divider"></view>
      
      <view class="info-row">
        <view class="info-item">
          <text class="info-icon">💺</text>
          <view class="info-content">
            <text class="info-label">剩余座位</text>
            <text class="info-value seats-value">
              <text class="seats-available">{{ride.availableSeats}}</text>
              <text class="seats-total">/{{ride.seats}}座</text>
            </text>
          </view>
        </view>
      </view>
      
      <view class="info-divider"></view>
      
      <view class="info-row">
        <view class="info-item">
          <text class="info-icon">🚗</text>
          <view class="info-content">
            <text class="info-label">车牌号</text>
            <text class="info-value">{{ride.vehicle.plateNumber || '未填写'}}</text>
          </view>
        </view>
      </view>
      
      <view class="info-divider" wx:if="{{ride.remark}}"></view>
      
      <view class="info-row" wx:if="{{ride.remark}}">
        <view class="info-item">
          <text class="info-icon">📝</text>
          <view class="info-content">
            <text class="info-label">路线备注</text>
            <text class="info-value">{{ride.remark}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="booking-section">
    <view class="booking-card">
      <text class="booking-title">预订座位</text>
      <view class="booking-row">
        <view class="seat-selector" bindtap="onSeatTap">
          <text class="seat-label">预订座位数</text>
          <view class="seat-value-wrap">
            <text class="seat-value">{{bookingSeats}}座</text>
            <text class="seat-arrow">›</text>
          </view>
        </view>
      </view>
      
      <view class="price-summary">
        <view class="price-row">
          <text class="price-label">单价</text>
          <text class="price-value">¥{{ride.fee}}/座</text>
        </view>
        <view class="price-row">
          <text class="price-label">数量</text>
          <text class="price-value">{{bookingSeats}}座</text>
        </view>
        <view class="price-row total">
          <text class="price-label">合计</text>
          <text class="price-value total-value">¥{{ride.fee * bookingSeats}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="agreement-section">
    <text class="agreement-text">预订即表示同意</text>
    <text class="agreement-link">《合乘协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link">《服务条款》</text>
  </view>

  <view class="bottom-bar">
    <view class="price-display">
      <text class="price-prefix">合计：</text>
      <text class="price-amount">¥{{ride.fee * bookingSeats}}</text>
    </view>
    <button class="book-btn" bindtap="handleBook">
      立即预订
    </button>
  </view>

  <picker 
    wx:if="{{showSeatPicker}}"
    mode="selector" 
    range="{{seatOptions}}" 
    value="{{bookingSeats - 1}}"
    bindchange="onSeatChange"
    bindcancel="onSeatPickerCancel"
  ></picker>
</view>

<view class="loading-state" wx:if="{{!ride}}">
  <text class="loading-text">加载中...</text>
</view>
