.index-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1890ff 0%, #40a9ff 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

.search-section {
  padding: 40rpx 30rpx;
}

.search-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.location-row {
  display: flex;
  align-items: center;
  position: relative;
}

.location-item {
  flex: 1;
  display: flex;
  align-items: center;
}

.location-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.start-dot {
  background: #1890ff;
}

.end-dot {
  background: #52c41a;
}

.location-input {
  flex: 1;
  height: 72rpx;
  font-size: 32rpx;
  color: #333;
}

.location-input::placeholder {
  color: #ccc;
}

.swap-btn {
  width: 64rpx;
  height: 64rpx;
  background: #f0f7ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
  flex-shrink: 0;
}

.swap-icon {
  font-size: 32rpx;
  color: #1890ff;
}

.divider {
  height: 1rpx;
  background: #e8e8e8;
  margin: 24rpx 0;
}

.extra-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-picker {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f7f8fa;
  border-radius: 40rpx;
}

.date-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.date-text {
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: none;
  line-height: 1;
}

.search-icon {
  margin-right: 8rpx;
}

.content-section {
  background: #f5f5f5;
  border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx 30rpx;
  min-height: 60vh;
}

.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-desc {
  font-size: 24rpx;
  color: #999;
}

.clear-btn {
  font-size: 26rpx;
  color: #999;
}

.recent-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-content {
  display: flex;
  align-items: center;
}

.recent-start,
.recent-end {
  font-size: 30rpx;
  color: #333;
}

.recent-arrow {
  margin: 0 16rpx;
  color: #999;
}

.recent-time {
  font-size: 24rpx;
  color: #999;
}

.popular-grid {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.popular-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popular-item:last-child {
  border-bottom: none;
}

.popular-info {
  flex: 1;
}

.popular-route {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.popular-start,
.popular-end {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.popular-arrow {
  margin: 0 16rpx;
  color: #1890ff;
  font-weight: bold;
}

.popular-count {
  font-size: 24rpx;
  color: #999;
}

.popular-arrow-right {
  font-size: 36rpx;
  color: #ccc;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.quick-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  background: #f0f7ff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}
